# Generated by scripts/gen_env_example.py. Do not edit; run the script after changing a plugin.
#
# Sample environment for homelab-automation.
# RECOMMENDED: keep secrets in UnENVerse (docs/UNV.md). The engine then runs under `unv exec` and you
# set none of the secrets below.
# FALLBACK: copy this file to .env, run `chmod 600 .env`, and fill in only what your plugins need.
# The engine refuses a .env that other users can read, and reads only the names plugins declare.

# --- engine ---
# HOMELAB_CONFIG=    # folder with homelab.yaml, plugins.yaml and jobs.yaml (default: ./config)

# --- internal, set by the engine, never by you ---
# HOMELAB_SECRETS_LOADED    # set by the engine when it re-executes under unv; never set it yourself

# --- UnENVerse, only when unv must authenticate by itself (scheduled runs); see docs/UNV.md ---
# UNV_SERVER_URL=    # remote unv-server, for example http://localhost:8743
# UNV_TOKEN=    # API token instead of a password (needs UNV_SERVER_URL); best for scheduled runs
# UNV_USER=    # sign in as this sub-user instead of the vault owner (needs UNV_SERVER_URL)
# UNV_TOTP=    # second-factor code for a UNV_USER login that has TOTP on
# UNV_PASSWORD=    # vault password; avoid, prefer --password-file or `unv login`
# UNV_FINGERPRINT=    # pin the server's TLS certificate to this SHA-256
# UNV_CA_CERT=    # trust this CA certificate (PEM), and only this one, for UNV_SERVER_URL

# --- secrets declared by bundled plugins and scripts ---
# none yet: a plugin lists its secrets in its manifest, and they appear here

# --- secrets of your own private plugins: one line per name your manifests declare ---
# MY_PLUGIN_API_KEY=
