{
  "$defs": {
    "Policy": {
      "additionalProperties": false,
      "description": "How much a job may do. deny: not even a plan. plan: plan only. ask: apply needs a person (--yes). auto: a\nscheduled pipeline may apply it unattended. The first matching rule wins; `default` covers the rest.",
      "properties": {
        "default": {
          "enum": [
            "deny",
            "plan",
            "ask",
            "auto"
          ],
          "type": "string",
          "default": "ask",
          "title": "Default"
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PolicyRule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "PolicyRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "title": "Match",
          "type": "string"
        },
        "level": {
          "enum": [
            "deny",
            "plan",
            "ask",
            "auto"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "match",
        "level"
      ],
      "title": "PolicyRule",
      "type": "object"
    },
    "Secrets": {
      "additionalProperties": false,
      "description": "Where plugin secrets come from. `auto` tries the process environment, then UnENVerse\n(recommended), then a .env file (fallback). Values are never printed or stored.",
      "properties": {
        "provider": {
          "default": "auto",
          "enum": [
            "auto",
            "unv",
            "dotenv",
            "env"
          ],
          "title": "Provider",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "entries": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Entries",
          "type": "object"
        },
        "dotenv": {
          "default": ".env",
          "title": "Dotenv",
          "type": "string"
        }
      },
      "title": "Secrets",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "secrets": {
      "$ref": "#/$defs/Secrets",
      "default": {
        "provider": "auto",
        "project": null,
        "entries": {},
        "dotenv": ".env"
      }
    },
    "state_dir": {
      "default": "state",
      "title": "State Dir",
      "type": "string"
    },
    "custom_dir": {
      "default": "custom",
      "title": "Custom Dir",
      "type": "string"
    },
    "scripts_dir": {
      "default": "",
      "title": "Scripts Dir",
      "type": "string"
    },
    "paths": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Paths",
      "type": "object"
    },
    "schedule_wrapper": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Schedule Wrapper",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/Policy",
      "default": {
        "default": "ask",
        "rules": []
      }
    },
    "inventory": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "default": {},
      "title": "Inventory",
      "type": "object"
    }
  },
  "title": "Core",
  "type": "object"
}
